  "_note": "Blocks shared byte-for-byte by two or more OS tabs. Per-OS files pull them in with {\"use\": \"<key>\", \"id\": \"<this OS's id>\"}.",
  "jumpstart": {
    "gemini": {"name":"Gemini CLI","desc":"Google Gemini CLI — codegen layer","tier":"ai","cmd":"npm install -g @google/gemini-cli"},
    "alfred": {"name":"Alfred → qwen3:8b","desc":"Primary companion — always warm","tier":"ai","cmd":"ollama pull qwen3:8b"},
    "steward": {"name":"Steward → deepseek-r1:14b","desc":"Safety watchdog — always warm","tier":"ai","cmd":"ollama pull deepseek-r1:14b"},
    "scout": {"name":"Scout → llama3.2:3b","desc":"Field recon — always warm","tier":"ai","cmd":"ollama pull llama3.2:3b"},
    "embed": {"name":"nomic-embed-text","desc":"RAG embeddings","tier":"ai","cmd":"ollama pull nomic-embed-text"},
    "base": {"name":"base-devel + git","desc":"Must be first. Needed to build yay and AUR packages.","tier":"sys","cmd":"sudo pacman -S --needed --noconfirm base-devel git"},
    "yay": {"name":"yay (AUR helper)","desc":"Bootstrap yay if no AUR helper present. Auto-detected.","tier":"sys","cmd":"# Auto-bootstrapped in script"},
    "flatpak": {"name":"Flatpak + Flathub","desc":"App runtime — many GUI tools come via Flatpak","tier":"sys","cmd":"sudo pacman -S --needed --noconfirm flatpak && flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo"},
    "nvm": {"name":"Node.js via nvm","desc":"nvm → Node LTS. Required for Claude Code, Gemini CLI.","tier":"dev","cmd":"curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash && source ~/.bashrc && nvm install --lts"},
    "rust": {"name":"Rust + Cargo","desc":"Required for RTK, Yazi, Bevy","tier":"dev","cmd":"curl --proto \"=https\" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && source $HOME/.cargo/env"},
    "docker": {"name":"Docker CE","desc":"Container engine","tier":"core","cmd":"sudo pacman -S --needed --noconfirm docker docker-compose && sudo systemctl enable --now docker && sudo usermod -aG docker $USER"},
    "claude": {"name":"Claude Code (Hermes)","desc":"Agentic coding CLI","tier":"ai","cmd":"npm install -g @anthropic-ai/claude-code"},
    "rtk": {"name":"RTK","desc":"Compresses command output for AI coding agents (not the 'rtk' crate on crates.io)","tier":"dev","cmd":"cargo install --git https://github.com/rtk-ai/rtk","license":"Apache-2.0","help":"https://github.com/rtk-ai/rtk","helpType":"site"},
    "whisper": {"name":"Whisper STT","desc":"Local speech recognition — Alfred daemon","tier":"ai","cmd":"pipx install openai-whisper"},
    "piper": {"name":"Piper TTS","desc":"Local neural TTS — Alfred voice output","tier":"ai","cmd":"pipx install piper-tts"}
  },
